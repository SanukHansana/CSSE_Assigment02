# Spring loads this as Java properties: use KEY=value with no shell export or quotes.
# Existing MongoDB URI can remain in application-local.properties or the environment.
# Generate your own Base64 key with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_YOUR_GENERATED_BASE64_KEY
JWT_TTL_SECONDS=900
WEB_ALLOWED_ORIGINS=http://localhost:8081
